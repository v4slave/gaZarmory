APP_NAME="GAZ ARMORY"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://armory.example.com
FRONTEND_URL=https://armory.example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=armory_aa
DB_USERNAME=armory_aa
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=armory.example.com
SANCTUM_STATEFUL_DOMAINS=armory.example.com

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://armory.example.com/auth/discord/callback
DISCORD_WEBHOOK_URL=
